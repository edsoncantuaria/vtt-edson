{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vtt-edson.local/schemas/scene-state.json",
  "title": "SceneState",
  "type": "object",
  "required": ["grid", "tokens", "walls", "doors", "lights", "fog", "chat"],
  "properties": {
    "grid": {
      "type": "object",
      "required": ["size", "offsetX", "offsetY", "snap"],
      "properties": {
        "size": { "type": "number", "minimum": 8 },
        "offsetX": { "type": "number" },
        "offsetY": { "type": "number" },
        "snap": { "type": "boolean" }
      }
    },
    "backgroundUrl": { "type": ["string", "null"] },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "name", "ownerUserId"],
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "name": { "type": "string" },
          "ownerUserId": { "type": ["integer", "null"] },
          "imageUrl": { "type": ["string", "null"] },
          "size": { "type": "number", "default": 1 }
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x1", "y1", "x2", "y2"],
        "properties": {
          "id": { "type": "string" },
          "x1": { "type": "number" },
          "y1": { "type": "number" },
          "x2": { "type": "number" },
          "y2": { "type": "number" }
        }
      }
    },
    "doors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x1", "y1", "x2", "y2", "open"],
        "properties": {
          "id": { "type": "string" },
          "x1": { "type": "number" },
          "y1": { "type": "number" },
          "x2": { "type": "number" },
          "y2": { "type": "number" },
          "open": { "type": "boolean" }
        }
      }
    },
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "radius"],
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "radius": { "type": "number", "minimum": 0 }
        }
      }
    },
    "fog": {
      "type": "object",
      "required": ["revealed"],
      "properties": {
        "revealed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number" },
              "h": { "type": "number" }
            }
          }
        }
      }
    },
    "chat": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "userId", "userName", "type", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "integer" },
          "userName": { "type": "string" },
          "type": { "enum": ["text", "roll"] },
          "text": { "type": "string" },
          "formula": { "type": "string" },
          "total": { "type": "number" },
          "detail": { "type": "string" },
          "createdAt": { "type": "string" }
        }
      }
    }
  }
}
